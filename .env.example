# Supabase Configuration

# The URL to your Supabase instance
SUPABASE_URL=your_supabase_url_here

# The API key for your Supabase instance
SUPABASE_API_KEY=your_supabase_api_key_here

# The database URL for your Supabase instance
SUPABASE_DATABASE_URL=your_supabase_database_url_here

# The project reference / name (if applicable)
SUPABASE_PROJECT_REF=your_project_ref_here
